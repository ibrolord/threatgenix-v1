# LLM Provider: "bedrock", "anthropic", "openai", "openrouter", "gemini",
#               "xai", "perplexity", "ollama", "auto" (tries in order)
LLM_PROVIDER=auto
# Production/staging default to Canada-only Bedrock. Set this only after explicit
# tenant/operator opt-in to allow direct Anthropic/OpenAI/OpenRouter/Gemini/etc.
ALLOW_EXTERNAL_AI_PROVIDERS_IN_PRODUCTION=false

# AWS Bedrock (using IAM user credentials — no session token needed)
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
# AWS_SESSION_TOKEN removed — using IAM user credentials instead of STS
AWS_DEFAULT_REGION=ca-central-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# Keep bulk security-review/report endpoints deterministic and fast by default.
# Focused per-threat intel still uses semantic retrieval when Bedrock is available.
SECURITY_REVIEW_SEMANTIC_INTEL_ENABLED=false

# Anthropic API (direct)
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# OpenAI
OPENAI_API_KEY=sk-proj-your-openai-key-here

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key-here

# xAI (Grok)
XAI_API_KEY=xai-your-xai-key-here

# Perplexity
PERPLEXITY_API_KEY=pplx-your-perplexity-key-here

# Ollama (local fallback)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Database (local dev)
# Production: use Supabase direct connection string + set DATABASE_SSL=require
# Supabase format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://threatgenix:password@localhost:5432/threatgenix
# DATABASE_SSL=require   # uncomment for Supabase / any hosted Postgres requiring SSL
ALLOWED_ORIGINS=http://localhost:5173

# Deployment environment — controls logging verbosity and safety checks.
# Values: development | production.  Set APP_ENV=production on Fly.io / any hosted deployment.
APP_ENV=development

# Deterministic validation runner
# Hosted SaaS default: try_sandbox disables tenant-triggered CLI execution.
# Trusted self-hosted deployments can set self_hosted after isolating runners.
# SaaS can set managed only when a dedicated worker process is running.
THREATGENIX_VALIDATION_RUNTIME_MODE=try_sandbox
THREATGENIX_VALIDATION_MANAGED_RUNNER_ENABLED=false
# Keep local filesystem tools gated until the runner host and allowed roots are explicit.
# Sandboxed tools are resolved only from standard system paths:
# /opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
THREATGENIX_VALIDATION_ALLOWED_PATHS=
# Semgrep is enabled by default in code, but still requires the CLI and an allowed path root.
THREATGENIX_VALIDATION_SEMGREP_ENABLED=true
THREATGENIX_VALIDATION_OSV_SCANNER_ENABLED=true
THREATGENIX_VALIDATION_TRIVY_ENABLED=true
THREATGENIX_VALIDATION_CHECKOV_ENABLED=true
THREATGENIX_VALIDATION_TRUFFLEHOG_ENABLED=true
VALIDATION_WORKER_HEARTBEAT_INTERVAL=10
VALIDATION_WORKER_LEASE_SECONDS=90
VALIDATION_WORKER_MAX_ATTEMPTS=3
VALIDATION_WORKER_HEARTBEAT_FRESH_SECONDS=45
VALIDATION_ARTIFACT_BUNDLE_MAX_BYTES=15000000
VALIDATION_ARTIFACT_BUNDLE_MAX_ITEMS=20
# Process mode is the default. Container mode requires Docker/Podman and approved images.
THREATGENIX_VALIDATION_SANDBOX_MODE=process
THREATGENIX_VALIDATION_CONTAINER_RUNTIME=docker
THREATGENIX_VALIDATION_CONTAINER_CPUS=1
THREATGENIX_VALIDATION_CONTAINER_MEMORY=1g
THREATGENIX_VALIDATION_CONTAINER_PIDS=256
THREATGENIX_VALIDATION_CONTAINER_PULL=never
# Optional image overrides:
# THREATGENIX_VALIDATION_IMAGE_SEMGREP=semgrep/semgrep:latest
# THREATGENIX_VALIDATION_IMAGE_OSV_SCANNER=ghcr.io/google/osv-scanner:latest
# THREATGENIX_VALIDATION_IMAGE_TRIVY=aquasec/trivy:latest
# THREATGENIX_VALIDATION_IMAGE_CHECKOV=bridgecrew/checkov:latest
# Hosted SaaS isolated runner for networked scanners. Use only with checked-in
# GKE/Kubernetes proof, an egress proxy, digest-pinned wrapper images, and target
# verification for Nuclei.
# THREATGENIX_VALIDATION_ISOLATED_RUNNER_BACKEND=gke
# THREATGENIX_VALIDATION_ISOLATED_NAMESPACE=threatgenix-validation
# THREATGENIX_VALIDATION_ISOLATED_SERVICE_ACCOUNT=threatgenix-scanner
# THREATGENIX_VALIDATION_ISOLATED_EGRESS_PROXY_URL=http://threatgenix-egress-proxy:8080
# THREATGENIX_VALIDATION_NODE_LOCAL_DNS_CIDRS=169.254.20.10/32
# THREATGENIX_VALIDATION_CONTAINER_ISOLATION_PROOF=deploy/gcp/isolated-runner/README.md
# THREATGENIX_VALIDATION_K8S_API_SERVER=https://<gke-api-endpoint>
# THREATGENIX_VALIDATION_K8S_CA_CERT_B64=<base64-cluster-ca>
# THREATGENIX_VALIDATION_ISOLATED_IMAGE_OSV_SCANNER=us-docker.pkg.dev/project/scanners/osv-runner@sha256:<digest>
# THREATGENIX_VALIDATION_ISOLATED_IMAGE_NUCLEI=us-docker.pkg.dev/project/scanners/nuclei-runner@sha256:<digest>
# THREATGENIX_VALIDATION_NUCLEI_TEMPLATES=/opt/threatgenix/nuclei-templates/http-baseline.yaml
# THREATGENIX_VALIDATION_NUCLEI_REQUIRE_TARGET_VERIFICATION=true
THREATGENIX_VALIDATION_SCHEDULER_ENABLED=false
# Optional cron/CI entrypoint:
#   python -m app.cli.run_validation_schedules
# Set true only for a trusted worker process that should execute queued scans inline.
THREATGENIX_VALIDATION_SCHEDULER_RUN_INLINE=false
