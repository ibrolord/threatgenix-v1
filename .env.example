DATABASE_URL=postgresql+asyncpg://threatgenix:password@localhost:5432/threatgenix
APP_ENV=development
SECRET_KEY=dev-secret-change-in-production
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_EXPOSE_DEV_TOKENS=false

# Required in production/staging. Generate each independently:
# openssl rand -base64 32
SCAN_CREDENTIAL_KEY=
BYOK_ENCRYPTION_KEY=

# Safe default: imports and the curated Try Sandbox work, live scanners do not.
THREATGENIX_VALIDATION_RUNTIME_MODE=try_sandbox

BEDROCK_REGION=ca-central-1
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_MAX_TOKENS=4096
BEDROCK_TIMEOUT_SECONDS=30
ALLOWED_ORIGINS=http://localhost:5173
PDF_MAX_PAGES=30
